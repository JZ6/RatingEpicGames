{
  "name": "rating-epic-games",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:epic": "vite --config apps/epicgames/vite.config.ts",
    "dev:dlss": "vite --config apps/dlssdb/vite.config.ts",
    "build:epic": "vite build --config apps/epicgames/vite.config.ts",
    "build:dlss": "vite build --config apps/dlssdb/vite.config.ts",
    "lint": "eslint .",
    "test": "vitest run --config apps/epicgames/vite.config.ts && vitest run --config apps/dlssdb/vite.config.ts && vitest run --config shared/vitest.config.ts",
    "test:epic": "vitest run --config apps/epicgames/vite.config.ts",
    "test:dlss": "vitest run --config apps/dlssdb/vite.config.ts",
    "test:shared": "vitest run --config shared/vitest.config.ts && vitest run shared/scripts/",
    "update:epic": "node apps/epicgames/scripts/update.js",
    "update:dlss": "node apps/dlssdb/scripts/update.js"
  },
  "dependencies": {
    "fuzzball": "^2.2.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "happy-dom": "^20.9.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vitest": "^4.1.4"
  }
}
